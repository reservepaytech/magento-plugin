<?php
$orderdata_url = $block->escapeUrl($block->getUrl('reservepay/payment/orderdata'));
$paymentsession_url = $block->escapeUrl($block->getUrl('reservepay/payment/paymentsession'));
$checkout_url = $block->escapeUrl($block->getUrl('checkout/cart'));
$orderreceived_url = $block->escapeUrl($block->getUrl('checkout/onepage/success'));
$orderId = (int) $block->getRequest()->getParam('order_id');
?>
<script src="https://sdk.reservepay.com/js/v1/reservepay.js"></script>
<div id="reservepay-payment-form"></div>
<div id="reservepay-loading">Loading payment form...</div>
<script>
  (function () {
    'use strict';

    var orderId = <?php echo json_encode($orderId); ?>;

    if (!orderId) {
      document.getElementById('reservepay-loading').textContent = 'Invalid payment session.';
      return;
    }

    fetch(<?php echo json_encode($orderdata_url); ?>, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: JSON.stringify({
        order_id: orderId
      }),
    })
      .then(function (response) {
        if (!response.ok) throw new Error('Failed to load order data');
        return response.json();
      })
      .then(function (data) {
        document.getElementById('reservepay-loading').style.display = 'none';

        if (data.error) {
          document.getElementById('reservepay-payment-form').textContent = data.error;
          return;
        }

        if (typeof window.Reservepay === 'undefined') {
          console.error('Reservepay SDK not loaded.');
          return;
        }

        window.Reservepay.initReservepayFormUI({
          formType: 'embedded',
          merchantId: String(data.merchant_id),
          installationId: String(data.installation_id),
          formOptions: {
            containerSelector: '#reservepay-payment-form',
            amount: String(data.amount),
            async onPaymentSessionReady(sessionId) {
              try {
                await fetch(<?php echo json_encode($paymentsession_url); ?>, {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                  },
                  body: JSON.stringify({
                    payment_session_id: sessionId,
                    order_id: orderId,
                  }),
                  credentials: 'same-origin',
                });
                return;
              } catch (e) {
                console.error('Error sending payment session to server', e);
              }
              window.location.href = <?php echo json_encode($checkout_url); ?>;
            },
            async onPaymentSuccess(sessionId) {
              window.location.href = <?php echo json_encode($orderreceived_url); ?>;
            },
            async onPaymentFailed(sessionId) {
              window.location.href = <?php echo json_encode($checkout_url); ?>;
            }
          }
        });
      })
      .catch(function (err) {
        console.error('Failed to load payment data', err);
        document.getElementById('reservepay-loading').textContent = 'Unable to load payment form. Please return to checkout.';
      });
  })();
</script>
