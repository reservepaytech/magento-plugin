<?php
/** @var \Reservepay\Payment\Block\Form $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

$script = '(function(data) {' . <<<'JS'
    'use strict';

    var container = document.querySelector(data.containerSelector);
    var frame = container.parentElement;
    var overlay = frame.querySelector('.reservepay-payment-overlay');
    var overlayStatus = overlay.querySelector('.reservepay-payment-status');
    var overlayNote = overlay.querySelector('.reservepay-payment-note');
    var overlayLink = overlay.querySelector('.reservepay-payment-order');
    var backForm = document.querySelector('.reservepay-payment-back');
    overlayLink.href = data.orderUrl;
    overlayLink.textContent = data.messages.viewOrder;

    // After a payment succeeds the overlay covers the form until the order is paid. The server may need longer
    // than the first check, so "pending" lets the shopper leave while the poll keeps checking.
    var phases = {
        confirming: { status: data.messages.confirming, note: data.messages.keepOpen, link: false },
        pending: { status: data.messages.pending, note: '', link: true },
    };
    var phase = null;
    function setPhase(name) {
        var shown = phase !== null;
        phase = name;
        var next = phases[name] || null;
        overlay.hidden = next === null;
        container.inert = next !== null;
        frame.classList.toggle('is-covered', next !== null);
        if (next === null) {
            backForm.hidden = false;
            return;
        }
        backForm.hidden = true;
        overlayStatus.textContent = next.status;
        overlayNote.textContent = next.note;
        overlayNote.hidden = next.note === '';
        overlayLink.hidden = !next.link;
        if (!shown) {
            overlay.focus();
        }
    }

    function showMessage(text, linkLabel, linkHref) {
        container.textContent = '';
        var message = document.createElement('p');
        message.className = 'message notice';
        message.textContent = text;
        container.appendChild(message);
        if (linkLabel) {
            var link = document.createElement('a');
            link.className = 'action primary';
            link.href = linkHref;
            link.textContent = linkLabel;
            container.appendChild(link);
        }
    }

    async function post(url, body) {
        var response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify(Object.assign({ token: data.token }, body)),
            credentials: 'same-origin',
        });
        var json = null;
        try {
            json = await response.json();
        } catch (e) {
            console.error('Reservepay: response is not JSON', e);
        }
        return { ok: response.ok, body: json };
    }

    // Every path only asks the server to check the order. The server decides from Reservepay what happened.
    async function checkOrder(body) {
        try {
            var result = await post(data.syncUrl, body);
            if (result.body && typeof result.body.outcome === 'string') {
                return result.body.outcome;
            }
        } catch (e) {
            console.error('Reservepay: order check failed', e);
        }
        return 'unknown';
    }

    // Callbacks and the poll can answer at once. The first one that leaves the page wins.
    var leaving = false;
    function leaveFor(outcome) {
        if (!leaving && (outcome === 'paid' || outcome === 'refused')) {
            leaving = true;
            if (outcome === 'paid') {
                setPhase('confirming');
            }
            window.location.href = outcome === 'paid' ? data.successUrl : data.cartUrl;
        }
        return leaving;
    }

    // The payment form does not always report a captured payment, so the page also asks the server itself.
    var polling = false;
    function pollOrder() {
        if (polling) {
            return;
        }
        polling = true;
        var stopAt = Date.now() + 30 * 60 * 1000;
        (function next() {
            setTimeout(async function () {
                var outcome = await checkOrder({});
                if (leaveFor(outcome)) {
                    return;
                }
                if (phase !== null && outcome === 'failed') {
                    failPayment();
                } else if (Date.now() < stopAt) {
                    next();
                }
            }, 15000);
        })();
    }

    async function confirmPayment() {
        setPhase('confirming');
        var outcome = await checkOrder({});
        if (leaveFor(outcome)) {
            return;
        }
        if (outcome === 'failed') {
            failPayment();
            return;
        }
        setPhase('pending');
        pollOrder();
    }

    // Same order, new payment session: the reload starts the next attempt and shows the failure message.
    async function failPayment() {
        setPhase(null);
        if (!leaveFor(await checkOrder({ failed: true }))) {
            leaving = true;
            window.location.reload();
        }
    }

    // The latest payment session is already paid. The SDK would offer a new payment, so the page only confirms.
    if (data.paid) {
        confirmPayment();
        return;
    }

    if (typeof window.Reservepay === 'undefined') {
        console.error('Reservepay SDK not loaded.');
        return;
    }

    // The order's customerEmail, customerMobile and billingAddress. SDKs without one of these options ignore it.
    var formOptions = Object.assign({}, data.prefill, {
        containerSelector: data.containerSelector,
        amount: String(data.amount),
        currency: data.currency,
        // A started session keeps its method, so a shown QR code cannot be swapped for a card in the same form.
        lockPaymentMethodOnSessionReady: true,
        async onPaymentSessionReady(sessionId) {
            var started = false;
            try {
                var result = await post(data.paymentsessionUrl, { payment_session_id: sessionId });
                started = result.ok && result.body !== null && result.body.status === 'ok';
            } catch (e) {
                console.error('Reservepay: payment session request failed', e);
            }
            if (started) {
                pollOrder();
            } else {
                showMessage(data.messages.startFailed, data.messages.tryAgain, window.location.href);
            }
        },
        onPaymentSuccess: confirmPayment,
        onPaymentFailed: failPayment,
    });
    // A reopened session may already be paid, and its form need not report it again.
    if (data.paymentSessionId) {
        formOptions.paymentSessionId = data.paymentSessionId;
        checkOrder({}).then(leaveFor);
        pollOrder();
    }
    window.Reservepay.initReservepayFormUI({
        formType: 'embedded',
        merchantId: String(data.merchantId),
        installationId: String(data.installationId),
        formOptions: formOptions,
    });
JS . '})(' . $block->getInitPayload() . ');';
?>
<script src="<?= $escaper->escapeUrl($block->getSdkUrl()) ?>"></script>
<div class="reservepay-payment">
    <div class="reservepay-payment-frame">
        <div id="reservepay-payment-form"></div>
        <div class="reservepay-payment-overlay" tabindex="-1" hidden>
            <span class="reservepay-payment-spinner" aria-hidden="true"></span>
            <p class="reservepay-payment-status" role="status" aria-live="polite"></p>
            <p class="reservepay-payment-note"></p>
            <a class="reservepay-payment-order action primary" hidden></a>
        </div>
    </div>
    <form class="reservepay-payment-back" method="post" action="<?= $escaper->escapeUrl($block->getBackUrl()) ?>">
        <?= $block->getBlockHtml('formkey') ?>
        <input type="hidden" name="token" value="<?= $escaper->escapeHtmlAttr($block->getToken()) ?>">
        <button type="submit" class="action-link">
            <?= $escaper->escapeHtml(__('Choose another payment method')) ?>
        </button>
    </form>
</div>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $script, false) ?>
