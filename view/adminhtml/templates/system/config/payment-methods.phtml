<?php
/** @var \Reservepay\Payment\Block\Adminhtml\RefreshPaymentMethods $block */
/** @var \Magento\Framework\Escaper $escaper */
$init = $block->getData('init');
$mageInit = $init === null ? '' : json_encode(['Reservepay_Payment/js/payment-methods' => $init]);
$updated = $block->getData('updated');
?>
<div class="reservepay-payment-methods">
<?php if ($init === null): ?>
    <p><?= $escaper->escapeHtml(__('Not fetched yet. Click Refresh payment methods.')) ?></p>
<?php else: ?>
    <table class="admin__table-secondary"
           data-mage-init="<?= $escaper->escapeHtmlAttr($mageInit) ?>">
        <thead>
            <tr>
                <th><?= $escaper->escapeHtml(__('Category')) ?></th>
                <th><?= $escaper->escapeHtml(__('At checkout')) ?></th>
                <th><?= $escaper->escapeHtml(__('Methods')) ?></th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($block->getData('categories') as $category => $title): ?>
            <tr data-category="<?= $escaper->escapeHtmlAttr($category) ?>">
                <td><?= $escaper->escapeHtml($title) ?></td>
                <td data-role="checkout"><?= $escaper->escapeHtml(__('Checking...')) ?></td>
                <td data-role="methods"></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
    <?php if ($updated !== null): ?>
        <p class="note"><span><?= $escaper->escapeHtml($updated) ?></span></p>
    <?php endif; ?>
<?php endif; ?>
    <?= /* @noEscape */ $block->getData('button') ?>
</div>
